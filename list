/* ---------------------------------------------------
   swap()
   Swaps the data of two students by their IDs
   --------------------------------------------------- */
void swap() {
    int id1, id2;
    struct Student *first, *second;
    struct Student tempData;

    if (head == NULL) {
        printf("empty list Nothing to swap.\n");
        return;
    }

    printf("Enter first Student ID: ");
    scanf("%d", &id1);
    printf("Enter second Student ID: ");
    scanf("%d", &id2);

    if (id1 == id2) {
        printf("Both IDs are the same. Nothing to swap.\n");
        return;
    }

    /* Find first student */
    first = head;
    while (first != NULL && first->id != id1) {
        first = first->next;
    }


    second = head;
    while (second != NULL && second->id != id2) {
        second = second->next;
    }

    if (first == NULL || second == NULL) {
        printf("One or both IDs not found.\n");
        return;
    }

    tempData.id = first->id;
    strcpy(tempData.name, first->name);
    tempData.age = first->age;
    strcpy(tempData.course, first->course);
    tempData.marks = first->marks;

    first->id = second->id;
    strcpy(first->name, second->name);
    first->age = second->age;
    strcpy(first->course, second->course);
    first->marks = second->marks;

    second->id = tempData.id;
    strcpy(second->name, tempData.name);
    second->age = tempData.age;
    strcpy(second->course, tempData.course);
    second->marks = tempData.marks;

    printf("Student records swapped \n");
}



